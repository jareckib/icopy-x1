{
  "plugin": true,
  "name": "Remote Access",
  "version": "1.0.0",
  "initial_state": "menu",
  "states": {
    "menu": {
      "screen": {
        "title": "Remote Access",
        "content": {
          "type": "text",
          "lines": []
        },
        "buttons": {
          "left": "Back",
          "right": "Select"
        },
        "keys": {
          "UP": "call:menu_up",
          "DOWN": "call:menu_down",
          "OK": "call:menu_select",
          "M1": "finish",
          "M2": "call:menu_select"
        }
      },
      "transitions": {
        "on_result.choice==scan": "scanning",
        "on_result.choice==saved": "connecting",
        "on_result.choice==manual": "ssid",
        "on_result.choice==info": "loading_status",
        "on_result.choice==disconnect": "disconnecting",
        "on_error": "error",
        "on_result.choice==files": "files_loading",
        "on_result.choice==ssh": "ssh_loading",
        "on_result.choice==usb": "usb_loading",
        "on_result.choice==serial": "serial_loading",
        "on_result.choice==stop": "stop_confirm",
        "on_result.choice==file_manager": "files_loading",
        "on_result.choice==serial_ssh": "ssh_loading",
        "on_result.choice==serial_file_manager": "serial_file_manager",
        "on_result.choice==direct": "direct_confirm"
      },
      "on_enter": "call:draw_menu",
      "on_exit": "call:clear_menu"
    },
    "networks": {
      "screen": {
        "title": "Wi-Fi Scan",
        "content": {
          "type": "text",
          "lines": []
        },
        "buttons": {
          "left": "Back",
          "right": "Select"
        },
        "keys": {
          "UP": "call:networks_up",
          "DOWN": "call:networks_down",
          "OK": "call:networks_select",
          "M1": "set_state:menu",
          "M2": "call:networks_select"
        }
      },
      "transitions": {
        "on_result.choice==password": "password",
        "on_result.choice==manual": "ssid",
        "on_result.choice==rescan": "scanning",
        "on_error": "error"
      },
      "on_enter": "call:draw_networks",
      "on_exit": "call:clear_networks"
    },
    "ssid": {
      "screen": {
        "title": "Network SSID",
        "content": {
          "type": "text",
          "lines": [],
          "scrollable": false,
          "y": 55
        },
        "buttons": {
          "left": "Back",
          "right": "ABC"
        },
        "keys": {
          "OK": "call:accept_ssid",
          "M1": "set_state:menu",
          "M2": "input:charset"
        }
      },
      "on_enter": "call:input_ssid",
      "transitions": {
        "on_result.status==password": "password",
        "on_error": "error"
      }
    },
    "password": {
      "screen": {
        "title": "Wi-Fi Password",
