          "type": "text",
          "lines": [],
          "scrollable": false,
          "y": 50
        },
        "buttons": {
          "left": "Back",
          "right": "ABC"
        },
        "keys": {
          "OK": "call:finish_password",
          "M1": "call:discard_password",
          "M2": "input:charset",
          "ALL": "call:restart_password"
        }
      },
      "on_enter": "call:input_password",
      "transitions": {
        "on_result.status==save": "saving",
        "on_result.status==error": "error",
        "on_result.status==menu": "menu",
        "on_error": "error"
      }
    },
    "connecting": {
      "screen": {
        "title": "Connecting...",
