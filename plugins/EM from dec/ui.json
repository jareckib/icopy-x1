{
    "plugin": true,
    "name": "EM4102 From Dec",
    "version": "1.0.0",
    "initial_state": "init",

    "states": {

        "init": {
            "on_enter": "run:do_init",
            "screen": {
                "title": "EM4102 - Dec",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Initializing...", "size": "medium", "align": "center"}
                    ]
                },
                "buttons": {"left": null, "right": null},
                "keys": {}
            },
            "transitions": {
                "on_result.status==ok": "enter_dec",
                "on_error":             "enter_dec"
            }
        },

        "enter_dec": {
            "on_enter": "call:show_dec_input",
            "screen": {
                "title": "EM4102 From Dec",
                "content": {
                    "type": "text",
                    "lines": []
                },
                "buttons": {"left": "Exit", "right": "OK"},
                "keys": {
                    "UP":    "call:dec_roll_up",
                    "DOWN":  "call:dec_roll_down",
                    "LEFT":  "call:dec_move_left",
                    "RIGHT": "call:dec_move_right",
                    "OK":    "run:do_capture_dec",
                    "M2":    "run:do_capture_dec",
                    "M1":    "run:dec_back_cleanse"
                }
            },
            "transitions": {
                "on_result.status==ok":    "confirm_clone",
                "on_result.status==error": "validation_error",
                "on_error":                "validation_error"
            }
        },
        "confirm_clone": {
            "screen": {
                "title": "Confirm Clone",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": ""},
                        {"text": ""},
                        {"text": "DEC: {dec_id}",  "size": "medium", "align": "center"},
                        {"text": "HEX: {hex_uid}", "size": "large", "align": "center"},
                        {"text": ""},
                        {"text": "Place T5577 on reader", "size": "medium", "align": "center"},
                        {"text": "OK to clone",           "size": "medium", "align": "center"}
                    ]
                },
                "buttons": {"left": "Back", "right": "Clone"},
                "keys": {
                    "OK":  "run:do_clone",
                    "M2":  "run:do_clone",
                    "M1":  "set_state:enter_dec"
                }
            },
            "transitions": {
                "on_result.status==done":  "clone_ok",
                "on_result.status==error": "clone_error",
                "on_error":                "clone_error"
            }
        },

        "clone_ok": {
            "screen": {
                "title": "Clone OK",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "Write completed.", "size": "large", "align": "center"},
                        {"text": "Verified OK.", "size": "large", "align": "center"},
                        {"text": ""},
                        {"text": "DEC: {dec_id}",       "size": "medium", "align": "center"},
                        {"text": "HEX: {hex_uid}",      "size": "medium", "align": "center"},
                        {"text": "Tags: {clone_count}", "size": "medium", "align": "center"},
                        {"text": ""}
                    ]
                },
                "buttons": {"left": "New ID", "right": "Again"},
                "keys": {
                    "OK":  "run:do_clone",
                    "M2":  "run:do_clone",
                    "M1":  "set_state:enter_dec"
                }
            },
            "transitions": {
                "on_result.status==done":  "clone_ok",
                "on_result.status==error": "clone_error",
                "on_error":                "clone_error"
            }
        },

        "validation_error": {
            "screen": {
                "title": "Error",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "{error_msg}", "size": "medium"},
                        {"text": ""},
                        {"text": "OK - try again", "size": "medium"}
                    ]
                },
                "buttons": {"left": "Exit", "right": "Retry"},
                "keys": {
                    "OK":  "set_state:enter_dec",
                    "M2":  "set_state:enter_dec",
                    "M1":  "finish"
                }
            }
        },

        "clone_error": {
            "screen": {
                "title": "Error",
                "content": {
                    "type": "text",
                    "lines": [
                        {"text": "{error_msg}", "size": "medium"},
                        {"text": ""},
                        {"text": "OK - try again", "size": "medium"}
                    ]
                },
                "buttons": {"left": "Exit", "right": "Retry"},
                "keys": {
                    "OK":  "set_state:confirm_clone",
                    "M2":  "set_state:confirm_clone",
                    "M1":  "set_state:enter_dec"
                }
            }
        }

    }
}
