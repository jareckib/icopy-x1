{
    "plugin": true,
    "name": "EM4102 From Decimal",
    "version": "1.1.0",
    "initial_state": "init",
    "states": {
        "init": {
            "on_enter": "run:do_init",
            "screen": {
                "title": "EM4102 From Decimal",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Initializing...",
                            "size": "large",
                            "align": "center"
                        }
                    ],
                    "y": 110
                },
                "buttons": {
                    "left": null,
                    "right": null
                },
                "keys": {}
            },
            "transitions": {
                "on_result.status==ok": "enter_dec",
                "on_error": "enter_dec"
            }
        },
        "enter_dec": {
            "on_enter": "call:show_dec_input",
            "screen": {
                "title": "EM4102 From Decimal",
                "content": {
                    "type": "text",
                    "lines": []
                },
                "buttons": {
                    "left": "Exit",
                    "right": "OK"
                },
                "keys": {
                    "UP": "call:dec_roll_up",
                    "DOWN": "call:dec_roll_down",
                    "LEFT": "call:dec_move_left",
                    "RIGHT": "call:dec_move_right",
                    "OK": "call:do_capture_dec",
                    "M2": "call:do_capture_dec",
                    "M1": "finish",
                    "ALL": "call:dec_return_to_input"
                }
            },
            "transitions": {
                "on_result.status==ok": "confirm_clone",
                "on_result.status==error": "validation_error",
                "on_error": "validation_error"
            }
        },
        "confirm_clone": {
            "screen": {
                "title": "Confirm Clone",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Place T5577 on reader",
                            "size": "large",
                            "align": "center",
                            "color": "#202020"
                        },
                        {
                            "text": "OK - Clone tag",
                            "size": "large",
                            "align": "center",
                            "color": "#202020"
                        }
                    ],
                    "y": 119
                },
                "buttons": {
                    "left": "Back",
                    "right": "Clone"
                },
                "keys": {
                    "OK": "set_state:checking_t5577",
                    "M2": "set_state:checking_t5577",
                    "M1": "set_state:enter_dec"
                }
            },
            "on_enter": "call:draw_id_pairs"
        },
        "clone_ok": {
            "screen": {
                "title": "Clone OK",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Write completed.",
                            "size": "large",
                            "align": "center",
                            "color": "#202020"
                        },
                        {
                            "text": "Verified OK.",
                            "size": "large",
                            "align": "center",
                            "color": "#202020"
                        }
                    ],
                    "y": 43
                },
                "buttons": {
                    "left": "New ID",
                    "right": "Again"
                },
                "keys": {
                    "OK": "set_state:checking_t5577",
                    "M2": "set_state:checking_t5577",
                    "M1": "set_state:enter_dec",
                    "ALL": "finish"
                }
            },
            "on_enter": "call:draw_success_pairs"
        },
        "validation_error": {
            "screen": {
                "title": "Error",
                "content": {
                    "type": "text",
                    "lines": []
                },
                "buttons": {
                    "left": "Exit",
                    "right": "Retry"
                },
                "keys": {
                    "M1": "finish",
                    "M2": "set_state:enter_dec",
                    "OK": "set_state:enter_dec"
                }
            },
            "on_enter": "call:draw_error"
        },
        "clone_error": {
            "screen": {
                "title": "Error",
                "content": {
                    "type": "text",
                    "lines": []
                },
                "buttons": {
                    "left": "Return",
                    "right": "Retry"
                },
                "keys": {
                    "OK": "set_state:checking_t5577",
                    "M2": "set_state:checking_t5577",
                    "M1": "set_state:enter_dec"
                }
            },
            "on_enter": "call:draw_error"
        },
        "checking_t5577": {
            "on_enter": "run:do_quick_search",
            "screen": {
                "title": "Quick LF Search",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Searching LF tag...",
                            "size": "large",
                            "align": "center"
                        },
                        {
                            "text": "Timeout: 5 seconds",
                            "size": "large",
                            "align": "center"
                        }
                    ],
                    "y": 81
                },
                "buttons": {
                    "left": null,
                    "right": null
                },
                "keys": {}
            },
            "transitions": {
                "on_result.status==ok": "detecting_t5577",
                "on_result.status==error": "clone_error",
                "on_error": "clone_error",
                "on_result.status==error_t5577_timeout": "error_t5577_timeout",
                "on_result.status==error_clone_failed": "error_clone_failed",
                "on_result.status==error_verification_timeout": "error_verification_timeout",
                "on_result.status==error_verification_mismatch": "error_verification_mismatch",
                "on_result.status==error_verify_failed": "error_verify_failed",
                "on_result.status==recover_reader": "recovering_reader"
            }
        },
        "writing_t5577": {
            "on_enter": "run:do_write",
            "screen": {
                "title": "Writing T5577",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Writing EM4102",
                            "size": "large",
                            "align": "center"
                        },
                        {
                            "text": "data...",
                            "size": "large",
                            "align": "center"
                        },
                        {
                            "text": "Timeout: 15 seconds",
                            "size": "large",
                            "align": "center"
                        }
                    ],
                    "y": 81
                },
                "buttons": {
                    "left": null,
                    "right": null
                },
                "keys": {}
            },
            "transitions": {
                "on_result.status==ok": "verifying_t5577",
                "on_result.status==error": "clone_error",
                "on_error": "clone_error",
                "on_result.status==error_t5577_timeout": "error_t5577_timeout",
                "on_result.status==error_clone_failed": "error_clone_failed",
                "on_result.status==error_verification_timeout": "error_verification_timeout",
                "on_result.status==error_verification_mismatch": "error_verification_mismatch",
                "on_result.status==error_verify_failed": "error_verify_failed"
            }
        },
        "verifying_t5577": {
            "on_enter": "run:do_verify",
            "screen": {
                "title": "Verifying T5577",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Verifying written",
                            "size": "large",
                            "align": "center"
                        },
                        {
                            "text": "ID...",
                            "size": "large",
                            "align": "center"
                        },
                        {
                            "text": "Timeout: 5 seconds",
                            "size": "large",
                            "align": "center"
                        }
                    ],
                    "y": 81
                },
                "buttons": {
                    "left": null,
                    "right": null
                },
                "keys": {}
            },
            "transitions": {
                "on_result.status==done": "clone_ok",
                "on_result.status==error": "clone_error",
                "on_error": "clone_error",
                "on_result.status==error_t5577_timeout": "error_t5577_timeout",
                "on_result.status==error_clone_failed": "error_clone_failed",
                "on_result.status==error_verification_timeout": "error_verification_timeout",
                "on_result.status==error_verification_mismatch": "error_verification_mismatch",
                "on_result.status==error_verify_failed": "error_verify_failed",
                "on_result.status==recover_reader": "recovering_reader"
            }
        },
        "detecting_t5577": {
            "on_enter": "run:do_precheck",
            "screen": {
                "title": "Checking T5577",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Detecting T5577...",
                            "size": "large",
                            "align": "center"
                        },
                        {
                            "text": "Timeout: 10 seconds",
                            "size": "large",
                            "align": "center"
                        }
                    ],
                    "y": 81
                },
                "buttons": {
                    "left": null,
                    "right": null
                },
                "keys": {}
            },
            "transitions": {
                "on_result.status==ok": "writing_t5577",
                "on_result.status==error": "clone_error",
                "on_error": "clone_error",
                "on_result.status==error_t5577_timeout": "error_t5577_timeout",
                "on_result.status==error_clone_failed": "error_clone_failed",
                "on_result.status==error_verification_timeout": "error_verification_timeout",
                "on_result.status==error_verification_mismatch": "error_verification_mismatch",
                "on_result.status==error_verify_failed": "error_verify_failed",
                "on_result.status==recover_reader": "recovering_reader"
            }
        },
        "error_t5577_timeout": {
            "screen": {
                "title": "Error",
                "content": {
                    "type": "text",
                    "lines": []
                },
                "buttons": {
                    "left": "Return",
                    "right": "Retry"
                },
                "keys": {
                    "OK": "set_state:checking_t5577",
                    "M2": "set_state:checking_t5577",
                    "M1": "set_state:enter_dec"
                }
            },
            "on_enter": "call:draw_error"
        },
        "error_clone_failed": {
            "screen": {
                "title": "Error",
                "content": {
                    "type": "text",
                    "lines": []
                },
                "buttons": {
                    "left": "Return",
                    "right": "Retry"
                },
                "keys": {
                    "OK": "set_state:checking_t5577",
                    "M2": "set_state:checking_t5577",
                    "M1": "set_state:enter_dec"
                }
            },
            "on_enter": "call:draw_error"
        },
        "error_verification_timeout": {
            "screen": {
                "title": "Error",
                "content": {
                    "type": "text",
                    "lines": []
                },
                "buttons": {
                    "left": "Return",
                    "right": "Retry"
                },
                "keys": {
                    "OK": "set_state:checking_t5577",
                    "M2": "set_state:checking_t5577",
                    "M1": "set_state:enter_dec"
                }
            },
            "on_enter": "call:draw_error"
        },
        "error_verification_mismatch": {
            "screen": {
                "title": "Error",
                "content": {
                    "type": "text",
                    "lines": []
                },
                "buttons": {
                    "left": "Return",
                    "right": "Retry"
                },
                "keys": {
                    "OK": "set_state:checking_t5577",
                    "M2": "set_state:checking_t5577",
                    "M1": "set_state:enter_dec"
                }
            },
            "on_enter": "call:draw_error"
        },
        "error_verify_failed": {
            "screen": {
                "title": "Error",
                "content": {
                    "type": "text",
                    "lines": []
                },
                "buttons": {
                    "left": "Return",
                    "right": "Retry"
                },
                "keys": {
                    "OK": "set_state:checking_t5577",
                    "M2": "set_state:checking_t5577",
                    "M1": "set_state:enter_dec"
                }
            },
            "on_enter": "call:draw_error"
        },
        "recovering_reader": {
            "on_enter": "run:do_recover_reader",
            "screen": {
                "title": "Reader recovery",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "Restarting PM3...",
                            "size": "large",
                            "align": "center"
                        }
                    ],
                    "y": 110
                },
                "buttons": {
                    "left": null,
                    "right": null
                },
                "keys": {}
            },
            "transitions": {
                "on_result.status==error": "clone_error",
                "on_result.status==error_t5577_timeout": "error_t5577_timeout",
                "on_result.status==error_verification_timeout": "error_verification_timeout",
                "on_result.status==recovery_failed": "recovery_failed",
                "on_error": "recovery_failed"
            }
        },
        "recovery_failed": {
            "on_enter": "call:draw_error",
            "screen": {
                "title": "Error",
                "content": {
                    "type": "text",
                    "lines": []
                },
                "buttons": {
                    "left": "Exit",
                    "right": null
                },
                "keys": {
                    "M1": "finish",
                    "OK": "finish"
                }
            }
        }
    }
}
