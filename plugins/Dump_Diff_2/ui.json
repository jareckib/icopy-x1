        "title": "Dump Diff 2",
        "content": {
          "type": "text",
          "lines": [
            {
              "text": "Loading...",
              "size": "large",
              "align": "center"
            }
          ]
        },
        "buttons": {
          "left": "Back",
          "right": null
        },
        "keys": {}
      },
      "transitions": {
        "on_result.status==legacy_firmware": "firmware_notice",
        "on_result.status==ok": "start_menu",
        "on_error": "start_menu"
      }
    },
    "firmware_notice": {
      "on_enter": "call:draw_firmware_notice",
      "screen": {
        "title": "Dump Diff 2",
        "content": {"type": "text", "lines": []},
        "buttons": {"left": null, "right": "Continue"},
        "keys": {"M2": "set_state:start_menu", "OK": "set_state:start_menu"}
      }
    },
    "types": {
      "screen": {
        "title": "Dump Compare",
        "content": {
          "type": "text",
          "lines": []
        },
        "buttons": {
          "left": "Menu",
          "right": "Select"
        },
        "keys": {
          "UP": "call:type_up",
          "DOWN": "call:type_down",
          "OK": "run:choose_current_type",
          "M2": "run:choose_current_type",
          "M1": "set_state:start_menu"
        }
      },
      "transitions": {
        "on_result.status==ok": "picker"
      },
      "on_enter": "call:enter_screen",
      "on_exit": "call:clear_types"
    },
    "picker": {
      "on_enter": "call:enter_screen",
      "on_exit": "call:picker_clear",
      "screen": {
        "title": "{picker_title}",
        "content": {
          "type": "text",
          "lines": []
        },
        "buttons": {
          "left": "Back",
          "right": "Comp."
        },
        "keys": {
          "UP": "call:picker_up",
          "DOWN": "call:picker_down",
          "OK": "call:picker_toggle",
          "M2": "run:picker_m2",
          "M1": "set_state:types",
          "LEFT": "call:picker_left",
          "RIGHT": "call:picker_right",
          "ALL": "run:prepare_details"
        }
      },
      "transitions": {
        "on_result.status==first": "details_first",
        "on_result.status==middle": "details_middle",
        "on_result.status==last": "details_last",
        "on_result.status==single": "details_single",
        "on_result.status==need_two": "need_two",
        "on_result.status==mode": "compare_mode",
        "on_result.status==identical": "identical_details",
        "on_result.status==different": "different_details",
        "on_result.status==details_ready": "details_dispatch",
        "on_result.status==error": "error",
        "on_error": "error"
      }
    },
    "error": {
      "screen": {
        "title": "Result compare",
        "content": {
          "type": "text",
          "lines": [
            {
              "text": "",
              "size": "large",
              "align": "center"
            },
            {
              "text": "",
              "size": "large",
              "align": "center"
            },
            {
              "text": "{dd_msg_1014}",
              "size": "large",
              "align": "center"
            },
            {
              "text": "{error_msg}",
